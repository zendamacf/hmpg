# Production Docker Compose (.env next to docker-compose.yml on the VPS)
DB_PASSWORD=
UNSPLASH_ACCESS_KEY=
PUBLIC_SENTRY_DSN=
CRON_SECRET=
# Full origin URL — used by the SvelteKit app (CSRF / absolute URLs)
ORIGIN=https://hmpg.kalopsia.dev
APP_PORT=3000
# Published image from a v* tag (see .github/workflows/publish-docker.yml)
APP_IMAGE=ghcr.io/zendamacf/hmpg:latest
